---
// The header's brand in Microsoft Learn's pattern: the mark, the name, a divider, then "Guide" as a name.
// The page title (the browser tab) stays the config's "Miserly Guide".
import { logos } from 'virtual:starlight/user-images';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="Miserly Guide">
	{logos.dark && <img alt="" src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />}
	<span translate="no">Miserly</span>
	<span class="rule" aria-hidden="true"></span>
	<span>Guide</span>
</a>

<style>
	.site-title {
		align-items: center;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.rule {
		width: 1px;
		height: 20px;
		background: currentColor;
		opacity: 0.45;
		margin: 0 4px;
	}
</style>
