---
// Starlight's footer (edit link, previous and next), then the landing's footer band.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<div class="mw-fband">
	<nav aria-label="Site">
		<a href="/">Home</a>
		<a href="https://github.com/justanothermedialab/miserly">GitHub</a>
		<a href="https://github.com/justanothermedialab/miserly/releases">Release notes</a>
		<a href="https://github.com/justanothermedialab/miserly/blob/main/PRIVACY.md">Privacy</a>
		<a href="https://github.com/justanothermedialab/miserly/blob/main/LICENSE">Licence</a>
		<a href="https://github.com/sponsors/varunnjbehera">Sponsor</a>
	</nav>
	<p>AGPL-3.0. Built with AI assistance. © 2026 <a href="https://www.jamlab.in/">JAM Lab</a></p>
</div>

<style>
	.mw-fband {
		margin-top: 2.5rem;
		padding: 18px 20px;
		border-radius: 10px;
		background: var(--mw-fband);
		color: var(--mw-fon);
		font-size: 13px;
	}
	.mw-fband nav { display: flex; flex-wrap: wrap; gap: 8px 22px; }
	.mw-fband p { margin: 10px 0 0; }
	.mw-fband a { color: inherit; text-decoration: none; }
	.mw-fband a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
