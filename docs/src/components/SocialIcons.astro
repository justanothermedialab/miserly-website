---
// The header's right side, as on the landing's nav: Home and Release notes, the Download button
// (to the landing's Download section, where the Store badge and the zip are),
// then Starlight's GitHub icon.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="mw-link" href="/">Home</a>
<a class="mw-link" href="https://github.com/justanothermedialab/miserly/releases">Release notes</a>
<a class="mw-btn" href="/#download">Download</a>
<Default />

<style>
	.mw-link {
		color: var(--sl-color-white);
		text-decoration: none;
		font-size: 15px;
		white-space: nowrap;
	}
	.mw-link:hover { text-decoration: underline; text-underline-offset: 3px; }
	.mw-btn {
		display: inline-flex;
		align-items: center;
		height: 38px;
		padding: 0 16px;
		border-radius: 8px;
		background: var(--sl-color-accent);
		color: var(--sl-color-text-invert);
		font: 600 15px/1 var(--sl-font);
		text-decoration: none;
		white-space: nowrap;
	}
	.mw-btn:hover { filter: brightness(1.25); }
	:global(:root:not([data-theme='light'])) .mw-btn:hover { filter: brightness(0.9); }
</style>
